# ClipForge Zero — copy to .env and fill in. NEVER commit a filled .env.
# All values below are placeholders only.

# Server (localhost only by default)
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8765

# Data directory (defaults to ./data inside the project root)
CLIPFORGE_DATA_DIR=./data

# BYOK credentials are configured through the UI Vault (OS keychain),
# never stored in this file. These lines are documentation only.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Publishing safety: must be one of private|unlisted|public (default private)
CLIPFORGE_DEFAULT_VISIBILITY=private
CLIPFORGE_AUTOPILOT=false
